{
  "name": "genius-unu-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend/*",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:user": "bun --filter @genius-unu/user dev",
    "dev:admin": "bun --filter @genius-unu/admin dev",
    "dev:backend": "bun --filter @genius-unu/backend dev",
    "build": "bun --filter '*' build",
    "build:user": "bun --filter @genius-unu/user build",
    "build:admin": "bun --filter @genius-unu/admin build",
    "build:backend": "bun --filter @genius-unu/backend build",
    "typecheck": "bun --filter '*' typecheck"
  }
}
